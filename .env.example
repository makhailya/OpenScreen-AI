OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT_SECONDS=120

# Необязательная конфигурация STT. Модели загружаются только после запуска диктовки.
# OPENSCREEN_STT_MODEL_DIR должен указывать на каталог с файлами
# encoder.int8.onnx, decoder.int8.onnx, joiner.int8.onnx и tokens.txt.
# Этот контракт подходит для Parakeet TDT v2 и проверенного Ultra INT8 export.
OPENSCREEN_STT_MODEL_DIR=
# Отдельная модель Silero VAD в формате, поддерживаемом Sherpa-ONNX.
OPENSCREEN_STT_VAD_MODEL_PATH=
